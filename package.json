{
	"name": "obsidian-mediavault-plugin",
	"version": "1.0.3",
	"description": "Track movies, TV shows, reviews, rewatches, and mood-based comfort media inside Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src --ext .ts",
		"test": "vitest run"
	},
	"keywords": [
		"obsidian-plugin",
		"movies",
		"tv-tracking",
		"media"
	],
	"author": "ruveydayilmaz",
	"license": "MIT",
	"dependencies": {
		"chart.js": "^4.4.1",
		"jszip": "^3.10.1"
	},
	"devDependencies": {
		"@types/node": "^20.11.0",
		"esbuild": "^0.20.0",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"jsdom": "^29.1.1",
		"obsidian": "latest",
		"tslib": "2.6.2",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.67.0",
		"vitest": "^1.2.0"
	}
}
