{
	"name": "obsidian-mediavault-plugin",
	"version": "1.0.7",
	"description": "Track movies, TV shows, reviews, rewatches, and mood-based comfort media inside Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src --ext .ts",
		"test": "vitest run"
	},
	"keywords": [
		"obsidian-plugin",
		"movies",
		"tv-tracking",
		"media"
	],
	"author": "ruveydayilmaz",
	"license": "MIT",
	"dependencies": {
		"chart.js": "^4.5.1",
		"jszip": "^3.10.1"
	},
	"devDependencies": {
		"@types/node": "^26.3.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.9.1",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"jsdom": "^30.0.1",
		"obsidian": "1.13.1",
		"tslib": "2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.68.0",
		"vitest": "^4.1.11"
	}
}
